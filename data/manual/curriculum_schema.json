{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Art Director AI Academy Curriculum",
  "type": "object",
  "properties": {
    "faculties": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "majors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "role": { "type": "string" },
                "courses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "string" },
                      "title": { "type": "string" },
                      "level": { "enum": ["Year 1", "Year 2", "Year 3", "Year 4"] },
                      "subjects": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "id": { "type": "string" },
                            "title": { "type": "string" },
                            "lessons": {
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "id": { "type": "string" },
                                  "title": { "type": "string" },
                                  "objective": { "type": "string" },
                                  "searchKeywords": { "type": "array", "items": { "type": "string" } },
                                  "mode": { "enum": ["Mileage", "Focus"] },
                                  "durationMinutes": { "type": "integer" }
                                },
                                "required": ["id", "title", "objective", "searchKeywords", "mode", "durationMinutes"]
                              }
                            }
                          },
                          "required": ["id", "title", "lessons"]
                        }
                      }
                    },
                    "required": ["id", "title", "level", "subjects"]
                  }
                }
              },
              "required": ["id", "title", "role", "courses"]
            }
          }
        },
        "required": ["id", "name", "majors"]
      }
    }
  },
  "required": ["faculties"]
}
